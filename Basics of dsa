CONDITIONAL STATEMENT:
(A)NESTED 
age = 20
citizen = True

if age >= 18:
    if citizen == True:
        print("Eligible to vote")
    else:
        print("Citizenship required")
else:
    print("Age requirement not met")

(B)IF-ELIF-ELSE Statement:
marks = 85

if marks >= 90:
    print("Grade A")
elif marks >= 75:
    print("Grade B")
elif marks >= 50:
    print("Grade C")
else:
    print("Fail")

(C)IF ELSE STATEMENT:
age = 16

if age >= 18:
    print("Eligible to vote")
else:
    print("Not eligible to vote")

